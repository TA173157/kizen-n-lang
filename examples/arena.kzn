function calculateFibonacci(let n: int): int {
    if (n == 0) {
        return 0;
    }
    if (n == 1) {
        return 1;
    }
    // this is a comment
    let prev1: int = 0;
    let prev2: int = 1;
    let current: int = 0;
    for (let i: int = 2; i <= n; i++) {
        current = prev1 + prev2;
        prev1 = prev2;
        prev2 = current;
    }
    
    return current;
}

function main(): int {
    print("=== DSA: Fibonacci Sequence ===");
    print("Enter N to find the N-th Fibonacci number:");
    
    let n: int = 0;
    scan(n);
    
    print("------------------");
    print("Calculating...");
    
    let result: int = calculateFibonacci(n);
    
    print("The Fibonacci number is:");
    print(result);
    print("==========================");
    
    return 0;
}